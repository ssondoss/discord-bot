# ============================================================
# Discord Bot — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Your bot's application/client ID (found on the General Information page)
CLIENT_ID=your_bot_client_id_here

# The ID of the Discord server (guild) where commands will be registered
# Right-click your server icon → Copy Server ID (requires Developer Mode)
GUILD_ID=your_guild_id_here

# ============================================================
# SETUP INSTRUCTIONS
# ============================================================
#
# 1. Prerequisites
#    - Node.js 18 or newer
#    - npm
#    - On macOS/Linux: Xcode CLI tools (for native addons)
#      → xcode-select --install
#
# 2. Install dependencies
#    npm install
#
# 3. Create your .env file
#    cp .env.example .env
#    Then fill in DISCORD_TOKEN, CLIENT_ID, and GUILD_ID.
#
# 4. Register slash commands with Discord
#    npm run register
#    This only needs to be run once (or when you add/change commands).
#
# 5. Start the bot
#    Development (auto-transpile, no compile step):
#      npm run dev
#
#    Production (compile first, then run):
#      npm run build
#      npm start
#
# 6. Bot permissions required in Discord Developer Portal:
#    OAuth2 scopes : bot, applications.commands
#    Bot permissions: Connect, Speak, Send Messages, Attach Files,
#                     Use Slash Commands, Read Message History
#
# ============================================================
